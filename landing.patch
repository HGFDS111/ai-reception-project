+}
+/* Hero: side labels and handwritten note */
+.heroSteps {
+  position: absolute;
+  top: 14%;
+  right: 28px;
+  z-index: 2;
+  margin: 0;
+  padding: 0 0 0 14px;
+  list-style: none;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  border-left: 1px solid #cfd9e3;
+  font-size: 14px;
+  color: var(--color-text-secondary);
+}
+
+.heroSteps li {
+  position: relative;
+}
+
+.heroStepActive {
+  color: var(--color-text);
+}
+
+.heroStepActive::before {
+  content: "";
+  position: absolute;
+  left: -15px;
+  top: 0;
+  bottom: 0;
+  width: 2px;
+  background: var(--color-text);
+}
+
+.heroNote {
+  position: absolute;
+  right: 20px;
+  bottom: 22%;
+  z-index: 2;
+  margin: 0;
+  font-family: "Caveat", "Segoe Script", "Bradley Hand", cursive;
+  font-size: 22px;
+  line-height: 1.2;
+  color: #5b6b85;
+  transform: rotate(-6deg);
+}
+
+.heroNote::after {
+  content: "";
+  display: block;
+  width: 96px;
+  height: 2px;
+  margin: 8px 0 0 auto;
+  border-radius: 2px;
+  background: #8a97ad;
+  transform: rotate(-3deg);
+}
